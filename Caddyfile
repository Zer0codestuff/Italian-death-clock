{
    admin off
    persist_config off
    auto_https off

    log {
        format json
    }

    servers {
        trusted_proxies static private_ranges 100.0.0.0/8
    }
}

:{$PORT:3000} {
    root * /srv
    encode zstd gzip

    @health path /health
    respond @health "OK" 200

    header /assets/* Cache-Control "public, max-age=31536000, immutable"
    header /index.html Cache-Control "no-cache"

    try_files {path} /index.html
    file_server
}
